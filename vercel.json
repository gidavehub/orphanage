{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/front-end-only.mjs && next build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-dvfijsfwpq-uc.a.run.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
    }
  ]
}
